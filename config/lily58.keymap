#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        // Home row mods — left hand. urob's "timeless" recipe: balanced + require-prior-idle.
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <
                6  7  8  9  10 11
                18 19 20 21 22 23
                30 31 32 33 34 35
                43 44 45 46 47 48 49
                54 55 56 57
            >;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Home row mods — right hand. Hold triggers only when left-hand key is pressed.
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <
                0  1  2  3  4  5
                12 13 14 15 16 17
                24 25 26 27 28 29
                36 37 38 39 40 41 42
                50 51 52 53
            >;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        // Rust digraph macros — triggered by combos on bottom-right row
        arrow: arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
        };

        fat_arrow: fat_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
        };

        colon2: colon2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp COLON>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // N+M => "->"  |  M+, => "=>"  |  ,+. => "::"
        combo_arrow {
            timeout-ms = <30>;
            key-positions = <44 45>;
            bindings = <&arrow>;
        };

        combo_fat_arrow {
            timeout-ms = <30>;
            key-positions = <45 46>;
            bindings = <&fat_arrow>;
        };

        combo_colon2 {
            timeout-ms = <30>;
            key-positions = <46 47>;
            bindings = <&colon2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -----------------------------------------------------------------------
// | ESC  |  1  |  2  |  3  |  4  |  5  |       |  6  |  7  |  8  |  9  |  0  |  `  |
// | TAB  |  Q  |  W  |  E  |  R  |  T  |       |  Y  |  U  |  I  |  O  |  P  |  -  |
// | CTRL |GUI/A|ALT/S|CTL/D|SHF/F|  G  |       |  H  |SHF/J|CTL/K|ALT/L|GUI/;|  '  |
// |      |  Z  |  X  |  C  |  V  |  B  |  [  | |  ]  |  N  |  M  |  ,  |  .  |  /  |      |
//                    |LSHFT| GUI | LWR | SPC | | ENT | RSE |BSPC |RSHFT|
//
// HRMs (hold for mod, tap for letter): A=GUI  S=Alt  D=Ctrl  F=Shift  J=Shift  K=Ctrl  L=Alt  ;=GUI
// Combos (bottom-right row): N+M => "->"   M+, => "=>"   ,+. => "::"
            bindings = <
&kp ESC   &kp N1       &kp N2       &kp N3        &kp N4       &kp N5                           &kp N6 &kp N7        &kp N8        &kp N9       &kp N0          &kp GRAVE
&kp TAB   &kp Q        &kp W        &kp E         &kp R        &kp T                            &kp Y  &kp U         &kp I         &kp O        &kp P           &kp MINUS
&kp LCTRL &hml LGUI A  &hml LALT S  &hml LCTRL D  &hml LSHFT F &kp G                            &kp H  &hmr RSHFT J  &hmr RCTRL K  &hmr RALT L  &hmr RGUI SEMI  &kp SQT
&trans    &kp Z        &kp X        &kp C         &kp V        &kp B  &kp LBKT     &kp RBKT     &kp N  &kp M         &kp COMMA     &kp DOT      &kp FSLH        &trans
                                    &kp LSHFT     &kp LGUI     &mo 1  &kp SPACE    &kp RET      &mo 2  &kp BSPC      &kp RSHFT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
// -----------------------------------------------------------------------
// | BTCLR| BT0 | BT1 | BT2 | BT3 | BT4 |       |     |     |     |     |     |     |
// |  _   |  !  |  @  |  #  |  $  |  %  |       |  ^  |  &  |  *  |  (  |  )  |  ~  |
// |  `   |  -  |  {  |  [  |  <  |  |  |       |  >  |  ]  |  }  |  =  |  +  |  \  |
// |      |     |     |     |  ?  |     |     | |     |     |     |     |     |     |      |
//                    |     |     | /// |     | |     |     |     |     |
//
// Row 2: shifted-number mirror -- lower + N = shift(N) for every number key
// Row 3: brackets paired across center (open left, close right); ops on edges
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                   &trans    &trans    &trans    &trans    &trans    &trans
&kp UNDER  &kp EXCL     &kp AT       &kp HASH      &kp DOLLAR   &kp PRCNT                       &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR  &kp TILDE
&kp GRAVE  &kp MINUS    &kp LBRC     &kp LBKT      &kp LT       &kp PIPE                        &kp GT    &kp RBKT  &kp RBRC  &kp EQUAL &kp PLUS  &kp BSLH
&trans     &trans       &trans       &trans        &kp QMARK    &trans  &trans     &trans        &trans    &trans    &trans    &trans    &trans    &trans
                                     &trans        &trans       &trans  &trans     &trans        &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
// -----------------------------------------------------------------------
// |STUDIO|     |     |     |     |     |       |     |     |     |     |     |     |
// |      | UNDO| CUT |COPY |PASTE|REDO |       |PGUP |PGDN |HOME | END | INS |     |
// |      | GUI | ALT |CTRL |SHFT |     |       |  <- |  v  |  ^  |  -> | DEL |     |
// |      |     |     |     |     |     |     | |     |     |     |     |     |     |      |
//                    |     |     |     |     | |     | /// |     |     |
//
// Left home row = direct modifiers for one-handed nav chords (e.g. Shift+arrow, Cmd+arrow)
// Right side = HJKL navigation + page/home/end on row above
            bindings = <
&studio_unlock &trans    &trans    &trans     &trans     &trans                                  &trans    &trans    &trans   &trans    &trans   &trans
&trans         &kp LG(Z) &kp LG(X) &kp LG(C)  &kp LG(V)  &kp LS(LG(Z))                         &kp PG_UP &kp PG_DN &kp HOME &kp END   &kp INS  &trans
&trans         &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans                                 &kp LEFT  &kp DOWN  &kp UP   &kp RIGHT &kp DEL  &trans
&trans         &trans    &trans    &trans     &trans     &trans  &trans     &trans               &trans    &trans    &trans   &trans    &trans   &trans
                                   &trans     &trans     &trans  &trans     &trans               &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
